# .env.example를 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.
# OAH_ANTHROPIC_API_KEY가 있으면 ANTHROPIC_API_KEY보다 우선한다.
ANTHROPIC_API_KEY=
# OAH_ANTHROPIC_API_KEY=
# LLM_MODEL=
# LLM_CACHE=true

# Azure OpenAI 호환 게이트웨이 (LLM_PROVIDER=azure_openai 또는 configs/llm.yaml의 provider)
# LLM_PROVIDER=azure_openai
MY_PROJECT_AZURE_API_KEY=
MY_PROJECT_AZURE_ENDPOINT=
MY_PROJECT_AZURE_API_VERSION=
